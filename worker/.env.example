# Copy to .env and fill in. NEVER commit a real .env.
# Local dev works with everything below unset (all integrations stub/fallback).

# --- Storage ---
# DATA_DIR holds the SQLite DB + downloaded sources + rendered clips (local dev).
# In DeployXA this should point at the persistent volume, e.g. /data.
DATA_DIR=./data

# --- Waitlist export (admin token for GET /api/waitlist/export) ---
# Generate one: python3 -c "import secrets; print(secrets.token_urlsafe(24))"
WAITLIST_ADMIN_TOKEN=

# --- Transcription: Groq Whisper (paid fallback; free tier 8 hrs/day) ---
# If unset, transcription falls back to local faster-whisper (tiny model, CPU).
GROQ_API_KEY=

# --- Scoring/hooks: Gemini 2.5 Flash-Lite only ---
# If unset, ranking uses the deterministic heuristic scorer (no LLM cost).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite

# --- Twitch (optional; viewer-clip signal + chat replay source) ---
# App access token, no user account. If unset, the Twitch signal is skipped.
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# --- Supabase (deploy only; local dev uses SQLite) ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Cloudflare R2 (deploy only; local dev uses local disk) ---
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=hookclip

# --- Paddle (STUBBED in P0 — checkout needs the owner's Paddle onboarding) ---
PADDLE_API_KEY=
PADDLE_WEBHOOK_SECRET=
PADDLE_STARTER_PRICE_ID=
PADDLE_PRO_PRICE_ID=
PADDLE_PACK_PRICE_ID=

# --- Resend (deploy only) ---
RESEND_API_KEY=

# --- CORS: comma-separated origins allowed to call the API ---
CORS_ORIGINS=http://localhost:3000,http://localhost:8000
